name: Build MOON X7 IPA

on:
  workflow_dispatch:
  push:
    branches: [main, master]

permissions:
  contents: read

jobs:
  build:
    runs-on: macos-15
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4

      - name: Locate project
        shell: bash
        run: |
          set -euo pipefail
          PROJECT="$(find "$GITHUB_WORKSPACE" -type d -name 'ThreeOneOSFive.xcodeproj' -print -quit)"
          [ -n "$PROJECT" ] || { echo "ERROR: ThreeOneOSFive.xcodeproj not found"; exit 1; }
          echo "PROJECT=$PROJECT" >> "$GITHUB_ENV"
          SOURCE_ROOT="$(dirname "$PROJECT")"
          echo "SOURCE_ROOT=$SOURCE_ROOT" >> "$GITHUB_ENV"

      - name: Validate resources
        shell: bash
        run: |
          set -euo pipefail
          PATCHES_DIR="$SOURCE_ROOT/ThreeOneOSFive/Patches"
          [ -d "$PATCHES_DIR" ] || { echo "ERROR: patches directory not found: $PATCHES_DIR"; exit 1; }
          find "$PATCHES_DIR" -type f -name '*.3105' -print

      - name: Build
        shell: bash
        run: |
          set -o pipefail
          xcodebuild \
            -project "$PROJECT" \
            -target 3105 \
            -configuration Release \
            -sdk iphoneos \
            CODE_SIGNING_ALLOWED=NO \
            CODE_SIGNING_REQUIRED=NO \
            CODE_SIGN_IDENTITY="" \
            SYMROOT="$GITHUB_WORKSPACE/build" \
            OBJROOT="$GITHUB_WORKSPACE/build/obj" \
            build 2>&1 | tee "$GITHUB_WORKSPACE/xcodebuild.log"

      - name: Package IPA with patches
        shell: bash
        run: |
          set -euo pipefail

          APP_PATH="$(find "$GITHUB_WORKSPACE/build" -type d -name '*.app' -print -quit)"
          if [ -z "$APP_PATH" ]; then
            echo "ERROR: application bundle not found after successful build"
            find "$GITHUB_WORKSPACE/build" -maxdepth 5 -type d -name '*.app' -print || true
            exit 1
          fi

          echo "App: $APP_PATH"

          APP_NAME="$(basename "$APP_PATH")"
          rm -rf "$GITHUB_WORKSPACE/Payload"
          mkdir -p "$GITHUB_WORKSPACE/Payload/$APP_NAME"
          ditto "$APP_PATH/" "$GITHUB_WORKSPACE/Payload/$APP_NAME/"

          PATCHES_DIR="$SOURCE_ROOT/ThreeOneOSFive/Patches"
          TEXTURES_DIR="$SOURCE_ROOT/ThreeOneOSFive/Textures"
          DEST_APP="$GITHUB_WORKSPACE/Payload/$APP_NAME"

          echo "Patches source: $PATCHES_DIR"
          echo "Textures source: $TEXTURES_DIR"

          [ -d "$PATCHES_DIR" ] || { echo "ERROR: patches directory not found: $PATCHES_DIR"; exit 1; }

          mkdir -p "$DEST_APP/Patches"

          if [ -d "$PATCHES_DIR/FF Normal" ]; then
            mkdir -p "$DEST_APP/Patches/FF Normal"
            ditto "$PATCHES_DIR/FF Normal/" "$DEST_APP/Patches/FF Normal/"
          fi

          if [ -d "$PATCHES_DIR/FF Max" ]; then
            mkdir -p "$DEST_APP/Patches/FF Max"
            ditto "$PATCHES_DIR/FF Max/" "$DEST_APP/Patches/FF Max/"
          fi

          # Keep compatibility with any legacy .3105 files directly under Patches.
          find "$PATCHES_DIR" -maxdepth 1 -type f -name '*.3105' -print -exec cp -f {} "$DEST_APP/Patches/" \;

          if [ -d "$TEXTURES_DIR" ]; then
            mkdir -p "$DEST_APP/Textures"
            ditto "$TEXTURES_DIR/" "$DEST_APP/Textures/"
          fi

          echo "Bundled patch resources:"
          find "$DEST_APP/Patches" -type f -name '*.3105' -print
          echo "Bundled texture resources:"
          if [ -d "$DEST_APP/Textures" ]; then
            find "$DEST_APP/Textures" -type f -name '*.3105' -print
          fi

          PATCH_COUNT="$(find "$DEST_APP/Patches" -type f -name '*.3105' | wc -l | tr -d ' ')"
          TEXTURE_COUNT="0"
          if [ -d "$DEST_APP/Textures" ]; then
            TEXTURE_COUNT="$(find "$DEST_APP/Textures" -type f -name '*.3105' | wc -l | tr -d ' ')"
          fi
          TOTAL_COUNT=$((PATCH_COUNT + TEXTURE_COUNT))

          echo "Patches bundled: $PATCH_COUNT"
          echo "Textures bundled: $TEXTURE_COUNT"
          echo "Total .3105 resources: $TOTAL_COUNT"

          [ "$TOTAL_COUNT" -gt 0 ] || { echo "ERROR: no .3105 resources were bundled"; exit 1; }

          cd "$GITHUB_WORKSPACE"
          rm -f MOON-X7-unsigned.ipa
          ditto -c -k --sequesterRsrc --keepParent Payload MOON-X7-unsigned.ipa

          [ -f MOON-X7-unsigned.ipa ] || { echo "ERROR: IPA was not created"; exit 1; }
          ls -lh MOON-X7-unsigned.ipa

      - uses: actions/upload-artifact@v4
        with:
          name: MOON-X7-unsigned-ipa
          path: MOON-X7-unsigned.ipa
          if-no-files-found: error

      - name: Upload log
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: xcodebuild-log
          path: xcodebuild.log
          if-no-files-found: ignore
